{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "crmtree-frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": { "standalone": true, "style": "scss", "changeDetection": "OnPush" }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "wt",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/crmtree-frontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles/global.scss",
              "node_modules/quill/dist/quill.snow.css"
            ],
            "scripts": [],
            "sourceMap": true,
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": [
                "crmtree.pl",
                "www.crmtree.pl",
                "crmtree-frontend.salmonsmoke-415d1384.polandcentral.azurecontainerapps.io",
                "crmtree-frontend-int.salmonsmoke-415d1384.polandcentral.azurecontainerapps.io",
                "localhost"
              ]
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "500kb", "maximumError": "1mb" },
                { "type": "anyComponentStyle", "maximumWarning": "10kb", "maximumError": "50kb" }
              ],
              "fileReplacements": [
                { "replace": "src/environments/environment.ts", "with": "src/environments/environment.prod.ts" }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": true },
                "fonts": { "inline": false }
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                { "replace": "src/environments/environment.ts", "with": "src/environments/environment.ts" }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
    "serve": {
      "builder": "@angular-devkit/build-angular:dev-server",
      "options": {
        "proxyConfig": "src/proxy.conf.json",
        "allowedHosts": ["localhost"]
      },
      "configurations": {
        "production": {
          "buildTarget": "crmtree-frontend:build:production"
        },
        "development": {
          "buildTarget": "crmtree-frontend:build:development"
        }
      },
      "defaultConfiguration": "development"
    }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
